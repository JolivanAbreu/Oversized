# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# URL pública onde esta API pode ser alcançada pela internet (necessária para
# o Mercado Pago enviar webhooks). Deixe em branco em desenvolvimento local —
# o app funciona normalmente sem webhook, usando consulta direta de status.
# Exemplo em produção: https://api.blusaoversized.com.br
API_PUBLIC_URL=

# Banco de dados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blusa_oversized_store
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blusa_oversized_store
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=30d

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=troque-por-um-segredo-do-webhook

# E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM="Blusã Oversized Store <naoresponda@blusaoversized.com.br>"

# Frete
SHIPPING_API_TOKEN=troque-pelo-token-melhor-envio

# Armazenamento de imagens
STORAGE_URL=
STORAGE_KEY=
